# Express server (server.ts) — never exposed to the browser
GEMINI_API_KEY=
BACKEND_PORT=8787

# Frontend (Vite) — safe to expose; the Supabase anon key is protected by
# Row Level Security, not by secrecy
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: restrict which origins may call the Express API (comma-separated).
# Leave blank to allow the Vite dev server / same-origin production build.
CORS_ORIGINS=

# --- Admin Panel (server/adminRouter.ts, adminAuth.ts, adminSupabase.ts) ---
# Never committed with real values. All required for the admin module to work.

# The admin login passcode (e.g. 6279). Hashed in memory at server start —
# never compared or stored in plaintext, and never hard-coded in source.
ADMIN_PASSCODE=

# Secret used to sign short-lived admin session JWTs. Use a long random
# string, separate from any other secret in this project.
ADMIN_JWT_SECRET=

# Supabase service_role key (Project Settings -> API). Bypasses Row Level
# Security — used ONLY by admin routes behind requireAdmin, to manage
# support-worker accounts (approve/suspend/reset) and read/assign across all
# users. Keep this out of the frontend and out of version control.
SUPABASE_SERVICE_ROLE_KEY=

# SMTP credentials used to email generated credentials/rejections/password
# resets to support workers (your own SMTP account — Gmail, Outlook, or a
# transactional provider's SMTP endpoint).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
