# ---------------------------------------------------------------------------
# Frontend (Vite) — these are bundled into the browser build, so they must only
# ever hold public values. Optional: src/services/supabaseClient.ts falls back
# to the project's public URL + publishable anon key when they're unset.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server / serverless function (api/index.ts) — never exposed to the browser.
# ---------------------------------------------------------------------------

# Admin portal (/admin). BOTH are required or admin login returns a 500 telling
# you which one is missing. ADMIN_PASSCODE is the shared passcode typed into the
# login screen; ADMIN_JWT_SECRET signs the 2-hour admin session token (use a
# long random string, e.g. `openssl rand -hex 32`).
ADMIN_PASSCODE=
ADMIN_JWT_SECRET=

# Required for every authenticated admin action (dashboard, verification queue,
# counselors, assignments, audit log, settings). Supabase dashboard ->
# Project Settings -> API -> service_role key. Bypasses RLS: server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side Supabase endpoint + anon key. Optional — both fall back to the
# project defaults in server/adminSupabase.ts and server/supabaseServer.ts.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Gemini key for the /api/ai/* and /api/chat routes. Without it those
# routes fail; the rest of the app (including admin) still works.
GEMINI_API_KEY=

# Outbound email for counselor approval / rejection / password-reset notices.
# Optional — approvals still succeed and surface the temporary password in the
# admin UI when SMTP is unset.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Bhashini (MeitY) translation, used by /api/translate to carry the interface
# into the 22 scheduled Indian languages. Without these the language picker
# still works, but only English, Hindi and Marathi — the three that ship with a
# hand-written dictionary — actually change the screen; every other choice
# shows English and says so.
#
# BHASHINI_UDYAT_KEY is the Udyat / ULCA key that authorises the pipeline-config
# call. BHASHINI_INFERENCE_API_KEY authorises the compute call. Either alone is
# enough to serve translations; both together is the normal setup.
# Check it on a deploy with:  /api/translate/status?probe=1&lang=hi
BHASHINI_UDYAT_KEY=
BHASHINI_INFERENCE_API_KEY=

# Optional Bhashini overrides. Defaults target the public MeitY pipeline and
# the Dhruva inference endpoint; set these only if your account was issued
# different ones.
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_SERVICE_ID=
BHASHINI_CONFIG_URL=
BHASHINI_COMPUTE_URL=

# Only needed if the frontend is served from a different origin than the API.
# Left empty, cross-origin requests are refused and same-origin still works.
CORS_ORIGINS=

# Self-hosted (npm run dev / npm start) only — ignored on Vercel.
BACKEND_PORT=
