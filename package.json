{
  "name": "aura",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:esm": "node scripts/check-esm-imports.mjs",
    "test:matching": "npx esbuild src/services/counsellorMatching.ts --format=esm --outfile=dist-test/counsellorMatching.js --log-level=error && node tests/matching.test.mjs",
    "seed:counsellors": "node scripts/seed-counsellors.mjs",
    "test:score": "npx esbuild src/services/recommendationEngine.ts --bundle --format=esm --outfile=dist-test/recEngine.js --log-level=error && node tests/score-integrity.test.mjs",
    "test:guardian": "npx esbuild src/services/guardianQuestions.ts --bundle --format=esm --outfile=dist-test/guardianQuestions.js --log-level=error && node tests/guardian.test.mjs",
    "test:crisis": "npx esbuild server/crisisDetection.ts --bundle --format=esm --outfile=dist-test/crisisDetection.js --log-level=error && node tests/crisis-detection.test.mjs",
    "test:safety-exit": "npx esbuild src/services/safetyExit.ts --bundle --format=esm --outfile=dist-test/safetyExit.js --log-level=error && node tests/safety-exit.test.mjs",
    "test:atrocity-lexicon": "npx esbuild src/services/atrocityLexicon.ts --bundle --format=esm --outfile=dist-test/atrocityLexicon.js --log-level=error && node tests/atrocity-lexicon.test.mjs",
    "test:voice-greeting": "npx esbuild src/voice/lib/audioPlayer.ts --bundle --format=esm --outfile=dist-test/audioPlayer.js --log-level=error && node tests/voice-greeting.test.mjs",
    "test:sla": "npx esbuild src/services/slaEngine.ts --bundle --format=esm --outfile=dist-test/slaEngine.js --log-level=error && node tests/sla.test.mjs",
    "test:instruments": "npx esbuild src/services/instruments.ts --bundle --format=esm --outfile=dist-test/instruments.js --log-level=error && node tests/instruments.test.mjs",
    "test:who5-schedule": "npx esbuild src/services/instruments.ts --bundle --format=esm --outfile=dist-test/instruments.js --log-level=error && node tests/who5-schedule.test.mjs",
    "test:concordance-policy": "npx esbuild src/services/concordanceEngine.ts --bundle --format=esm --outfile=dist-test/concordanceEngine.js --log-level=error && npx esbuild src/services/riskEngine.ts --bundle --format=esm --outfile=dist-test/riskEngine.js --log-level=error && node tests/concordance-policy.test.mjs",
    "test:community": "npx esbuild src/services/communityAggregates.ts --bundle --format=esm --outfile=dist-test/communityAggregates.js --log-level=error && node tests/community-aggregates.test.mjs",
    "test:cohort-stats": "npx esbuild src/services/communityAggregates.ts --bundle --format=esm --outfile=dist-test/communityAggregates.js --log-level=error && npx esbuild src/services/overrideStats.ts --bundle --format=esm --outfile=dist-test/overrideStats.js --log-level=error && node tests/cohort-stats.test.mjs",
    "test:offline-shell": "node tests/offline-shell.test.mjs",
    "test:fairness": "npx esbuild src/services/fairnessReport.ts --bundle --format=esm --outfile=dist-test/fairnessReport.js --log-level=error && node tests/fairness-report.test.mjs",
    "test:score-version": "npx esbuild src/services/riskEngine.ts --bundle --format=esm --outfile=dist-test/riskEngine.js --log-level=error && node tests/score-version.test.mjs",
    "test:exercises": "npx esbuild src/services/sectionExercises.ts --bundle --format=esm --outfile=dist-test/sectionExercises.js --log-level=error && node tests/section-exercises.test.mjs",
    "test:literacy": "npx esbuild src/services/literacyModules.ts --bundle --format=esm --outfile=dist-test/literacyModules.js --log-level=error && node tests/literacy-modules.test.mjs",
    "test:recovery": "npx esbuild src/services/recoveryHub.ts --bundle --format=esm --outfile=dist-test/recoveryHub.js --log-level=error && node tests/recovery-engine.test.mjs",
    "test:recovery-copy": "node tests/recovery-copy.test.mjs",
    "test:voice-consent": "node tests/voice-consent.test.mjs",
    "test:charts": "node tests/chart-integrity.test.mjs",
    "test:claims": "node tests/responsible-ai-claims.test.mjs",
    "test:switch": "node tests/counsellor-switch.browser.mjs",
    "test:voice-mute": "node tests/voice-mute.browser.mjs",
    "test:recovery-dates": "npx esbuild src/services/recoveryDateProjection.ts --bundle --format=esm --outfile=dist-test/recoveryDateProjection.js --log-level=error && npx esbuild src/services/escalationEngine.ts --bundle --format=esm --outfile=dist-test/escalationEngine.js --log-level=error && npx esbuild src/services/caseEvents.ts --bundle --format=esm --outfile=dist-test/caseEvents.js --log-level=error && node tests/recovery-date-sharing.test.mjs",
    "test:day-panel": "npx esbuild src/services/recommendationEngine.ts --bundle --format=esm --outfile=dist-test/recommendationEngine.js --log-level=error && npx esbuild src/services/riskEngine.ts --bundle --format=esm --outfile=dist-test/riskEngine.js --log-level=error && node tests/day-panel.test.mjs",
    "test:checkin-reflections": "node tests/checkin-reflections.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.16",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.69.0"
  }
}
